APP_ENV=development
TELEGRAM_BOT_TOKEN=replace-with-your-token
TELEGRAM_ALLOWED_USER_ID=0
ANTHROPIC_API_KEY=replace-with-your-key
ANTHROPIC_MODEL=claude-sonnet-4-5
DATABASE_URL=sqlite+aiosqlite:///./gwen.db
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_WEB_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v1
ELEVENLABS_WEB_STT_MODEL=scribe_v2
HISTORY_LIMIT=20
MAX_INPUT_CHARS=12000
DAILY_TOKEN_LIMIT=100000
BACKUP_RETENTION_DAYS=14
DAILY_VOICE_SECONDS_LIMIT=900
DAILY_TTS_CHARACTER_LIMIT=20000
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8765/api/spotify/callback
